{
  "manifest_version": 3,
  "name": "NotebookLM LaTeX Renderer",
  "version": "1.2",
  "description": "Rendert automatisch LaTeX-Formeln ($...$, $$...$$, \\ce{...}) auf notebooklm.google.com mithilfe von KaTeX und hebt sie hervor.",
  // "icons": { // Icons sind immer noch optional
  //   "48": "icons/icon48.png",
  //   "128": "icons/icon128.png"
  // },
  "content_scripts": [
    {
      "matches": ["https://notebooklm.google.com/*"],
      "css": [
        "katex/katex.min.css",
        "custom_styles.css"
        ],
      "js": [
        "katex/katex.min.js",
        "katex/auto-render.min.js",
        // KORRIGIERTER PFAD HIER:
        "katex/mhchem.min.js", // Nicht mehr "katex/contrib/mhchem.min.js"
        "content_script.js"
        ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [ "katex/fonts/*" ],
      "matches": [ "https://notebooklm.google.com/*" ]
    }
  ]
}

